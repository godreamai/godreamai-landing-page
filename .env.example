# Número de WhatsApp, formato internacional sin "+" (ej.: 5491112345678).
# Vacío = se usa el de godreamai.com (5493364294964).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio (para Open Graph, sitemap y robots).
NEXT_PUBLIC_SITE_URL=

# Email e Instagram. Vacíos = se usan los de godreamai.com (go@godreamai.com, @godreamai.ar).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Medición (opcional): Google Analytics 4 (G-XXXXXXX) y/o Meta Pixel (ID numérico).
# Ambos registran el evento de clic en WhatsApp ("whatsapp_click" / "Contact").
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
